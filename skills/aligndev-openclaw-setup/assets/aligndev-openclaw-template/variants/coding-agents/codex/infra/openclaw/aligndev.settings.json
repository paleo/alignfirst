{
  "projectsRoot": "~/projects",
  "portRange": { "first": {{PORT_RANGE_FIRST}}, "last": {{PORT_RANGE_LAST}} },
  "code": {
    "profiles": {
      "openclaw": { "harness": "openclaw", "defaultAgentProfile": "service-codex" },
      "service-codex": {
        "harness": "codex",
        "configDir": null,
        "skipPermissions": true,
        "unset": [
          "OPENAI_API_KEY",
          "CODEX_API_KEY",
          "CODEX_MANAGED_PACKAGE_ROOT",
          "CODEX_MANAGED_BY_NPM"
        ]
      }
    }
  }
}
