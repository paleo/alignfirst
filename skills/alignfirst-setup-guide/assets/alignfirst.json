{
  "$schema": "https://cdn.jsdelivr.net/npm/alignfirst/schemas/alignfirst-v1.schema.json",
  "schemaVersion": 1,
  "workspace": {
    "finalize": [
      {
        "name": "Install",
        "run": ["npm", "ci"]
      }
    ],
    "summary": "Workspace ${{ name }} \u2014 ${{ status }}\nPath: ${{ currentWorktree }}"
  },
  "devServer": {
    "maxConcurrentDevServers": { "env": "PROJECT_DEV_LIMIT", "default": 5 },
    "ports": {
      "first": 8100,
      "last": 8199,
      "declare": ["frontend"]
    },
    "runFiles": [
      {
        "path": ".env",
        "source": {
          "kind": "mainWorktree",
          "fallback": ".env.example"
        },
        "patch": {
          "env": {
            "PORT": "${{ ports.frontend }}"
          }
        }
      }
    ],
    "servers": [
      {
        "kind": "spawn",
        "name": "frontend",
        "exec": {
          "run": ["npm", "run", "dev:app"]
        },
        "port": "frontend",
        "ready": {
          "log": "ready|listening"
        },
        "error": { "preset": "node" }
      }
    ]
  }
}
