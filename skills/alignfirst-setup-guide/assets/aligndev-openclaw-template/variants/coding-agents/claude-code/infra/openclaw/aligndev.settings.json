{
  "platform": "openclaw",
  "projectsRoot": "~/projects",
  "code": {
    "profile": "service-claude",
    "profiles": {
      "service-claude": {
        "agent": "claude",
        "configDir": "~/.claude",
        "skipPermissions": true,
        "unset": ["ANTHROPIC_API_KEY"]
      }
    }
  }
}
