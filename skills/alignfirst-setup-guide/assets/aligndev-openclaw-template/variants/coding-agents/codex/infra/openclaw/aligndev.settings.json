{
  "platform": "openclaw",
  "projectsRoot": "~/projects",
  "code": {
    "profile": "service-codex",
    "profiles": {
      "service-codex": {
        "agent": "codex",
        "configDir": "~/.codex",
        "skipPermissions": true,
        "unset": [
          "OPENAI_API_KEY",
          "CODEX_API_KEY",
          "CODEX_MANAGED_PACKAGE_ROOT",
          "CODEX_MANAGED_BY_NPM"
        ]
      }
    }
  }
}
