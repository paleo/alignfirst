# Deployment values read by seed.sh. Copy to .env, fill in, never commit .env.
# The operator edits infra/openclaw/.env in the admin checkout; the snapshot at
# ~{{SERVICE_USER}}/seed/.env is refreshed from it (docs/installations/04-openclaw.md).

# OpenClaw runtime model — agents.defaults.model.primary. Consumed by seed.sh.
RUNTIME_PROVIDER={{RUNTIME_PROVIDER}}
RUNTIME_MODEL={{RUNTIME_MODEL}}

# API key of the runtime provider, when it authenticates by key. Leave empty to log in
# interactively instead (04 § Provider login). seed.sh stores it as a file SecretRef on
# models.providers.{{RUNTIME_PROVIDER}}.apiKey.
RUNTIME_API_KEY=

# Gateway auth token (loopback dashboard, reached through an SSH tunnel). seed.sh stores it
# as a file SecretRef. Fresh install: openssl rand -hex 32. Existing server: paste the current
# value so paired devices keep working:
#   sudo -u {{SERVICE_USER}} jq -r .GATEWAY_AUTH_TOKEN /home/{{SERVICE_USER}}/.openclaw/secrets/secrets.json
GATEWAY_AUTH_TOKEN=

# Browser origin of the dashboard. The default matches the SSH tunnel
#   ssh -N -L 18789:127.0.0.1:18789 {{SERVER_ADMIN_USER}}@<vps-ip>
# (the Control UI needs an allowed origin and a secure context; localhost qualifies).
GATEWAY_DASHBOARD_ORIGIN=http://localhost:18789

# Context7 API key (context7.com/dashboard) — the ctx7 CLI reads it per call. seed.sh writes it
# to ~/.openclaw/.env, the gateway env file inherited by exec children (05-openclaw-dependencies.md).
CONTEXT7_API_KEY=

# Discord. The bot answers in one allowlisted guild channel; a DM sender other than the owner gets a
# pairing code (docs/operations/pair-dm-sender.md). Admin commands and exec approvals are restricted
# to DISCORD_OWNER_ID. IDs are copied with Developer Mode on (Settings → Advanced → Developer Mode,
# then right-click → Copy ID). See docs/installations/07-channel.md.
# Bot token: application → Bot → Reset Token. Shown once; unique per running instance.
DISCORD_BOT_TOKEN=
# User ID of the owner (right-click your name → Copy User ID).
DISCORD_OWNER_ID={{DISCORD_OWNER_ID}}
# Server the bot is installed in (right-click the server icon → Copy Server ID).
DISCORD_GUILD_ID={{DISCORD_GUILD_ID}}
# Channel the bot answers in (right-click the channel → Copy Channel ID).
DISCORD_CHANNEL_ID={{DISCORD_CHANNEL_ID}}
