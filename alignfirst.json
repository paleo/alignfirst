{
  "$schema": "https://cdn.jsdelivr.net/npm/alignfirst/schemas/alignfirst-v1.schema.json",
  "schemaVersion": 1,
  "ticketIdPattern": "^\\d+$",
  "plans": {
    "repositoryFolder": "alignfirst",
    "autoArchive": true
  },
  "git": {
    "defaultBranch": "main",
    "branchNameTemplate": "{TICKET_ID}/{slug-1-3-words}",
    "commit": {
      "style": "conventionalCommit"
    },
    "agentCoauthoring": false
  }
}
