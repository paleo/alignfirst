{
  "name": "alignfirst-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docmap": "docmap",
    "plans:setup": "plans-share setup --folder alignfirst",
    "plans:sync": "plans-share sync",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "build": "npm run build --workspaces --if-present",
    "clear": "npm run clear --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "changeset": "changeset",
    "changeset:bump": "changeset version && npm i",
    "changeset:publish": "npm i && npm run clear && npm run build && npm run lint && npm run test && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.1",
    "@changesets/cli": "~2.31.0"
  }
}
