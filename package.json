{
  "name": "alignfirst-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docmap": "alignfirst docmap",
    "workspace": "alignfirst workspace",
    "plans:setup": "alignfirst plans setup",
    "plans:sync": "alignfirst sync",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "build": "npm run build --workspace @alignfirst/docmap --workspace @alignfirst/workspace --workspace alignfirst --workspace aligndev --workspace @alignfirst/openclaw-channel-mock-core --workspace @alignfirst/openclaw-discord-mock --workspace @alignfirst/openclaw-slack-mock --workspace @alignfirst/openclaw-test --workspace @alignfirst/pi-subagent --workspace @alignfirst/pi-background --workspace @alignfirst/service-openclaw-plugin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clear": "npm run clear --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:cli-runtimes": "node scripts/cli-runtimes.mjs",
    "test:openclaw": "npm run test:openclaw --workspaces --if-present && npm run test:openclaw-integration --workspace @alignfirst/service-openclaw-plugin && npm run test:openclaw-templates && npm test --prefix aligndev-openclaw-tests",
    "test:openclaw-templates": "node --test scripts/test/deployment-*.test.mjs scripts/test/openclaw-setup-skill-links.test.mjs",
    "changeset": "changeset",
    "ci:version": "changeset version && npm i",
    "release:smoke": "node scripts/release-smoke.mjs",
    "ci:publish": "npm run clear && npm run build && npm run lint && npm run test && npm pkg delete scripts --workspaces && npm run release:smoke && changeset publish"
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild@0.28.2": true,
    "koffi@3.3.2": true,
    "openclaw@2026.10.9": true,
    "protobufjs": false
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@changesets/cli": "~3.0.3"
  }
}
