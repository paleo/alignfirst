{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cdn.jsdelivr.net/npm/alignfirst/schemas/alignfirst-v1.schema.json",
  "title": "AlignFirst project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "const": 1
    },
    "plans": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repositoryFolder": {
          "$ref": "#/definitions/nonEmpty"
        },
        "autoArchive": {
          "type": "boolean"
        }
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticketIdPattern": {
          "$ref": "#/definitions/nonEmpty"
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultBranch": {
              "$ref": "#/definitions/nonEmpty"
            },
            "branchNameTemplate": {
              "$ref": "#/definitions/nonEmpty"
            },
            "agentCoauthoring": {
              "type": "boolean"
            },
            "commit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["style"],
              "properties": {
                "style": {
                  "const": "conventionalCommit"
                },
                "ticketReference": {
                  "enum": ["bracketed", "bracketedHash"]
                }
              }
            }
          }
        }
      }
    },
    "developerInstructions": {
      "type": "string",
      "pattern": "\\S"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sharedDirs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/nonEmpty"
          }
        },
        "gitignoredFiles": {
          "$ref": "#/definitions/files"
        },
        "preSetup": {
          "$ref": "#/definitions/steps"
        },
        "finalize": {
          "$ref": "#/definitions/steps"
        },
        "purge": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/purgeStep"
          }
        },
        "summary": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "devServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["servers"],
      "properties": {
        "ports": {
          "$ref": "#/definitions/ports"
        },
        "runFiles": {
          "$ref": "#/definitions/files"
        },
        "runFilesInputs": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/nonEmpty"
              }
            },
            {
              "$ref": "#/definitions/producer"
            }
          ]
        },
        "setup": {
          "$ref": "#/definitions/steps"
        },
        "servers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/server"
          },
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "spawn"
              }
            }
          }
        },
        "maxConcurrentDevServers": {
          "oneOf": [
            { "$ref": "#/definitions/limit" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["env", "default"],
              "properties": {
                "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])" },
                "default": { "$ref": "#/definitions/limit" }
              }
            }
          ]
        },
        "summary": {
          "$ref": "#/definitions/text"
        }
      }
    }
  },
  "definitions": {
    "limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "serverError": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "preset": { "const": "node" },
        "log": { "type": "string" }
      }
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last"],
      "properties": {
        "first": {
          "$ref": "#/definitions/port"
        },
        "last": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last", "declare"],
      "properties": {
        "first": {
          "$ref": "#/definitions/port"
        },
        "last": {
          "$ref": "#/definitions/port"
        },
        "exclude": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/port"
              },
              {
                "$ref": "#/definitions/range"
              }
            ]
          }
        },
        "declare": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/nonEmpty"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": {
                    "$ref": "#/definitions/nonEmpty"
                  },
                  "range": {
                    "$ref": "#/definitions/range"
                  },
                  "mainWorktree": {
                    "$ref": "#/definitions/port"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "run": {
      "oneOf": [
        {
          "$ref": "#/definitions/nonEmpty"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "run": {
          "$ref": "#/definitions/run"
        },
        "cwd": {
          "$ref": "#/definitions/nonEmpty"
        },
        "env": {
          "$ref": "#/definitions/env"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "run"],
      "properties": {
        "name": {
          "$ref": "#/definitions/nonEmpty"
        },
        "run": {
          "$ref": "#/definitions/run"
        },
        "cwd": {
          "$ref": "#/definitions/nonEmpty"
        },
        "env": {
          "$ref": "#/definitions/env"
        }
      }
    },
    "purgeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "run"],
      "properties": {
        "name": {
          "$ref": "#/definitions/nonEmpty"
        },
        "run": {
          "$ref": "#/definitions/run"
        },
        "cwd": {
          "$ref": "#/definitions/nonEmpty"
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "continueOnError": {
          "type": "boolean"
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "$ref": "#/definitions/command"
        }
      }
    },
    "text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/producer"
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/file"
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source"],
      "properties": {
        "path": {
          "$ref": "#/definitions/nonEmpty"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": {
                  "const": "mainWorktree"
                },
                "fallback": {
                  "$ref": "#/definitions/nonEmpty"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path"],
              "properties": {
                "kind": {
                  "const": "committed"
                },
                "path": {
                  "$ref": "#/definitions/nonEmpty"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "content"],
              "properties": {
                "kind": {
                  "const": "content"
                },
                "content": {
                  "$ref": "#/definitions/text"
                }
              }
            }
          ]
        },
        "patch": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["env"],
              "properties": {
                "env": {
                  "$ref": "#/definitions/env"
                }
              }
            },
            {
              "$ref": "#/definitions/producer"
            }
          ]
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log"],
      "properties": {
        "log": {
          "type": "string"
        }
      }
    },
    "serverName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "server": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "exec", "ready"],
          "properties": {
            "kind": {
              "const": "spawn"
            },
            "name": {
              "$ref": "#/definitions/serverName"
            },
            "exec": {
              "$ref": "#/definitions/command"
            },
            "port": {
              "oneOf": [
                {
                  "$ref": "#/definitions/nonEmpty"
                },
                {
                  "$ref": "#/definitions/port"
                }
              ]
            },
            "ready": {
              "$ref": "#/definitions/log"
            },
            "error": {
              "$ref": "#/definitions/serverError"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "start"],
          "properties": {
            "kind": {
              "const": "command"
            },
            "name": {
              "$ref": "#/definitions/serverName"
            },
            "start": {
              "$ref": "#/definitions/command"
            },
            "stop": {
              "$ref": "#/definitions/command"
            }
          }
        }
      ]
    }
  }
}
