{
  "name": "@alignfirst/docmap",
  "version": "0.12.0",
  "license": "CC0-1.0",
  "author": "Thomas MUR",
  "description": "A lightweight documentation system for AI agents and humans.",
  "keywords": [
    "documentation",
    "ai",
    "agent",
    "markdown",
    "docmap"
  ],
  "homepage": "https://alignfirst.paroi.tech/docmap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/docmap"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@12.2.0",
  "type": "module",
  "bin": {
    "docmap": "bin/docmap.mjs"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./invocation": "./dist/invocation.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clear": "rimraf dist/*",
    "lint": "biome check",
    "test": "vitest run",
    "test:invocation": "node ../../scripts/invocation-probe.mjs",
    "docmap": "node bin/docmap.mjs"
  },
  "devDependencies": {
    "@types/node": "~26.6.5",
    "rimraf": "~6.1.3",
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  }
}
