{
  "name": "@paleo/docmap",
  "version": "0.6.4",
  "license": "CC0-1.0",
  "author": "Thomas MUR",
  "description": "A lightweight documentation system for AI agents and humans.",
  "keywords": [
    "documentation",
    "ai",
    "agent",
    "markdown",
    "docmap"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/docmap"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@11.12.1",
  "type": "module",
  "bin": {
    "docmap": "bin/docmap.mjs"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clear": "rimraf dist/*",
    "lint": "biome check",
    "test": "vitest run",
    "docmap": "node bin/docmap.mjs"
  },
  "devDependencies": {
    "@types/node": "~24.12.4",
    "rimraf": "~6.1.3",
    "typescript": "~6.0.3",
    "vitest": "~4.1.7"
  }
}
