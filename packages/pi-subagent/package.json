{
  "name": "@alignfirst/pi-subagent",
  "version": "0.1.1",
  "description": "Synchronous isolated Pi subagents with bounded results and owned process cleanup.",
  "license": "MIT",
  "author": "Thomas MUR",
  "type": "module",
  "keywords": ["pi-package", "pi", "subagent"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/pi-subagent"
  },
  "engines": { "node": ">=22.19.0" },
