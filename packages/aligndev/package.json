{
  "name": "aligndev",
  "version": "0.29.0",
  "license": "CC0-1.0",
  "author": "Thomas MUR",
  "description": "The AlignDev CLI: the assistant's playbook, coding-agent delegation, and project inventory.",
  "keywords": [
    "ai",
    "agent",
    "alignfirst",
    "cli",
    "claude",
    "codex",
    "git",
    "projects",
    "worktrees"
  ],
  "homepage": "https://alignfirst.paroi.tech/aligndev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/aligndev"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@12.2.0",
  "type": "module",
  "bin": {
    "aligndev": "bin/aligndev.mjs"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clear": "rimraf dist/*",
    "lint": "biome check",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@alignfirst/docmap": "~0.12.0"
  },
  "devDependencies": {
    "@types/node": "~26.6.5",
    "rimraf": "~6.1.3",
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  }
}
