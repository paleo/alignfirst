# Consumer-agnostic base for the QA runner stack. Built locally by the CLI
# (`openclaw-qa-runner env build`) and tagged `paleo/openclaw-qa-runner-base:<pkg-version>`.
# The consumer's `qa/Dockerfile` does `FROM paleo/openclaw-qa-runner-base:${QA_RUNNER_BASE_TAG}`
# and adds the staging block plus its own customizations.
# Build context: this package's directory (so `dist/mock-cli-shim.js` is COPY-able).

FROM node:24-alpine

RUN apk add --no-cache shadow git

ARG CLAW_UID=1000
ARG CLAW_GID=1000
RUN (getent passwd ${CLAW_UID} && userdel -r "$(getent passwd ${CLAW_UID} | cut -d: -f1)" || true) && \
    (getent group ${CLAW_GID} && groupdel "$(getent group ${CLAW_GID} | cut -d: -f1)" || true) && \
    groupadd --gid ${CLAW_GID} claw && \
    useradd --create-home --shell /bin/sh --uid ${CLAW_UID} --gid ${CLAW_GID} claw && \
    mkdir -p /home/claw/.openclaw /opt/qa-src /opt/qa-artifacts /opt/qa-staging && \
    chown -R claw:claw /home/claw /opt/qa-src /opt/qa-artifacts /opt/qa-staging

# Mock-CLI shim under /opt/qa-mocks. OpenClaw's exec tool runs commands via
# `/bin/sh -lc`, which sources /etc/profile; Alpine's default resets PATH to a
# "safe" set that excludes /opt/qa-mocks/bin, so we override it.
COPY --chown=claw:claw dist/mock-cli-shim.js /opt/qa-mocks/dist/mock-cli-shim.js
RUN mkdir -p /opt/qa-mocks/bin && \
    printf '#!/bin/sh\nexec node /opt/qa-mocks/dist/mock-cli-shim.js "$0" "$@"\n' > /opt/qa-mocks/bin/mock-cli-shim && \
    chmod +x /opt/qa-mocks/bin/mock-cli-shim && \
    for name in git npm pnpm yarn claude; do ln -sf mock-cli-shim "/opt/qa-mocks/bin/$name"; done && \
    chown -R claw:claw /opt/qa-mocks && \
    printf 'export PATH="/opt/qa-mocks/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"\n' > /etc/profile

USER claw
WORKDIR /opt/qa-src

CMD ["sleep", "infinity"]
