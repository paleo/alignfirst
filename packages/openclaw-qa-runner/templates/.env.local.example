ANTHROPIC_API_KEY=

# Required: host path to the OpenClaw workspace (mounted into the gateway).
OPENCLAW_WORKSPACE_DIR=

# Optional overrides (defaults relative to this qa/ dir):
#   OPENCLAW_CONFIG_PATH=./openclaw.json
#   QA_PROJECTS_DIR=./projects-fixture
#   QA_SCENARIOS_DIR=./scenarios
#   QA_ARTIFACTS_DIR=./artifacts
#   QA_GATEWAY_LOGS_DIR=./.gateway-logs

# Opt-in gateway logs. Uncomment to enable. Writes to .gateway-logs/.
# OPENCLAW_ANTHROPIC_PAYLOAD_LOG=1
# OPENCLAW_RAW_STREAM=1
