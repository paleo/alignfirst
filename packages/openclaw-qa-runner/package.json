  },
  "dependencies": {
    "@anthropic-ai/sdk": "~0.97.1",
    "@paleo/openclaw-channel-mock-core": "0.2.2",
    "@paleo/openclaw-discord-mock": "0.2.2",
    "@paleo/openclaw-slack-mock": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "~24.12.4",
    "openclaw": "2026.5.18",
    "rimraf": "~6.1.3",
    "typescript": "~6.0.3"
  }
