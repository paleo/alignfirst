{
  "name": "@paleo/openclaw-qa-runner",
  "version": "0.4.0",
  "description": "Dockerised regression-test harness for OpenClaw workspaces: bus, scenario driver, judge, Compose stack.",
  "keywords": [
    "openclaw",
    "qa",
    "testing",
    "harness",
    "scenario",
    "docker"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/openclaw-qa-runner"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@11.11.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "openclaw-qa-runner": "./bin/cli.mjs"
  },
  "exports": "./dist/index.js",
  "files": [
