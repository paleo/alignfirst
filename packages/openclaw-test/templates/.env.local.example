ANTHROPIC_API_KEY=

# Required only when running a DashScope (Qwen) model; harmlessly empty otherwise.
DASHSCOPE_API_KEY=

# Agent model catalog. Comma list of full LiteLLM provider/model refs — the only
# place the provider/ prefix appears. `run --model <id>` and OPENCLAW_DEFAULT_TEST_MODEL
# use the bare id (the suffix after the last "/"). `--model all` runs every entry and
# needs the API key for each referenced provider.
OPENCLAW_TEST_MODELS=anthropic/claude-sonnet-4-6,custom-dashscope-intl-aliyuncs-com/qwen3.6-plus
OPENCLAW_DEFAULT_TEST_MODEL=claude-sonnet-4-6

# Required: host path to the OpenClaw workspace (mounted into the gateway).
OPENCLAW_WORKSPACE_DIR=

# Optional overrides (defaults relative to the project dir):
# OPENCLAW_CONFIG_PATH=./openclaw.json
# OPENCLAW_TEST_SCENARIOS_DIR=./scenarios
# OPENCLAW_TEST_ARTIFACTS_DIR=./artifacts
# OPENCLAW_TEST_GATEWAY_LOGS_DIR=./.gateway-logs

# Opt-in: also write raw-stream.jsonl alongside the always-on provider-neutral
# trajectory log (one <sessionId>.jsonl per session under .gateway-logs/trajectory/).
# OPENCLAW_RAW_STREAM=1
