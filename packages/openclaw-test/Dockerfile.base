# Consumer-agnostic base for the openclaw-test runner stack. Built locally by the CLI
# (`openclaw-test env build`) and tagged `paleo/openclaw-test-base:<pkg-version>`.
# Ships: Node + `shadow` (for the UID/GID dance), the mock-cli shim binary (no
# per-command symlinks — consumers add their own), and the exec RPC watcher.
# The consumer's project `Dockerfile` does `FROM paleo/openclaw-test-base:${OPENCLAW_TEST_BASE_TAG}`
# and adds whatever else the fixture needs (e.g. git, pnpm via corepack, mock symlinks).
# Build context: this package's directory (so `dist/mock-cli-shim.js` is COPY-able).

FROM node:26-alpine

RUN apk add --no-cache shadow

ARG ASSISTANT_UID=1000
ARG ASSISTANT_GID=1000
RUN (getent passwd ${ASSISTANT_UID} && userdel -r "$(getent passwd ${ASSISTANT_UID} | cut -d: -f1)" || true) && \
    (getent group ${ASSISTANT_GID} && groupdel "$(getent group ${ASSISTANT_GID} | cut -d: -f1)" || true) && \
    groupadd --gid ${ASSISTANT_GID} assistant && \
    useradd --create-home --shell /bin/sh --uid ${ASSISTANT_UID} --gid ${ASSISTANT_GID} assistant && \
    mkdir -p /home/assistant/.openclaw /opt/openclaw-test/src /opt/openclaw-test/artifacts && \
    chown -R assistant:assistant /home/assistant /opt/openclaw-test/src /opt/openclaw-test/artifacts

# Mock-CLI shim under /opt/openclaw-test/mocks. OpenClaw's exec tool runs commands via
# `/bin/sh -lc`, which sources /etc/profile; Alpine's default resets PATH to a
# "safe" set that excludes /opt/openclaw-test/mocks/bin, so we override it. Consumers
# create the per-command symlinks (e.g. claude, gh) in their own Dockerfile.
COPY --chown=assistant:assistant dist/mock-cli-shim.js /opt/openclaw-test/mocks/dist/mock-cli-shim.js
RUN mkdir -p /opt/openclaw-test/mocks/bin && \
    printf '#!/bin/sh\nexec node /opt/openclaw-test/mocks/dist/mock-cli-shim.js "$0" "$@"\n' > /opt/openclaw-test/mocks/bin/mock-cli-shim && \
    chmod +x /opt/openclaw-test/mocks/bin/mock-cli-shim && \
    chown -R assistant:assistant /opt/openclaw-test/mocks && \
    printf 'export PATH="/opt/openclaw-test/mocks/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"\n' > /etc/profile

# Exec RPC watcher. The gateway service spawns it in the background; the runner
# pokes requests onto the shared `openclaw-test-ipc` volume via `ctx.execInGateway(...)`.
# Pre-create the mountpoint with `assistant` ownership so a fresh named volume
# inherits it — otherwise Docker creates it as root:root and the assistant-uid
# processes get EACCES on the first write.
COPY --chown=root:root exec-watcher.mjs /usr/local/bin/exec-watcher
RUN chmod +x /usr/local/bin/exec-watcher && \
    mkdir -p /var/run/openclaw-test-ipc && chown assistant:assistant /var/run/openclaw-test-ipc

USER assistant
WORKDIR /opt/openclaw-test/src

CMD ["sleep", "infinity"]
