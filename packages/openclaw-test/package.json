{
  "name": "@alignfirst/openclaw-test",
  "version": "0.24.1",
  "description": "Dockerised regression-test framework for OpenClaw workspaces: bus, scenario driver, judge, Compose stack.",
  "keywords": [
    "openclaw",
    "test",
    "testing",
    "harness",
    "scenario",
    "docker"
  ],
  "license": "MIT",
  "author": "Thomas MUR",
  "homepage": "https://alignfirst.paroi.tech/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/openclaw-test"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "packageManager": "npm@12.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "openclaw-test": "./bin/cli.mjs"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist/",
    "bin/",
    "templates/",
    "docker-compose.yml",
    "Dockerfile.base",
    "exec-watcher.mjs",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clear": "rimraf dist/*",
    "lint": "biome check",
    "test": "vitest run"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "dependencies": {
    "@alignfirst/docmap": "~0.12.0",
    "@anthropic-ai/sdk": "~1.3.0",
    "@alignfirst/openclaw-channel-mock-core": "0.11.3",
    "@alignfirst/openclaw-discord-mock": "0.6.7",
    "@alignfirst/openclaw-slack-mock": "0.6.7",
    "openai": "~7.47.0"
  },
  "devDependencies": {
    "@types/node": "~26.6.6",
    "openclaw": "~2026.10.9",
    "rimraf": "~6.1.3",
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  }
}
