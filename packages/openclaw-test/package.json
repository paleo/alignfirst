{
  "name": "@paleo/openclaw-test",
  "version": "0.15.2",
  "description": "Dockerised regression-test framework for OpenClaw workspaces: bus, scenario driver, judge, Compose stack.",
  "keywords": [
    "openclaw",
    "test",
    "testing",
    "harness",
    "scenario",
    "docker"
  ],
  "license": "MIT",
  "author": "Thomas MUR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/openclaw-test"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@11.12.1",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "openclaw-test": "./bin/cli.mjs"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist/",
    "bin/",
    "templates/",
    "docker-compose.yml",
    "Dockerfile.base",
    "exec-watcher.mjs",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clear": "rimraf dist/*",
    "lint": "biome check",
    "test": "vitest run"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@paleo/openclaw-channel-mock-core": "0.6.0",
    "@paleo/openclaw-discord-mock": "0.3.6",
    "@paleo/openclaw-slack-mock": "0.3.6"
  },
  "devDependencies": {
    "@types/node": "~24.13.3",
    "openclaw": "2026.7.1",
    "rimraf": "~6.1.3",
    "typescript": "~7.0.2",
    "vitest": "~4.1.11"
  }
}
