{
  "name": "@alignfirst/pi-background",
  "version": "0.1.1",
  "description": "Session-owned background shell jobs with bounded output and native Pi completion.",
  "license": "MIT",
  "author": "Thomas MUR",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "background"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/pi-background"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.js",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clear": "rimraf dist/*",
    "lint": "biome check",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "~26.6.5",
    "rimraf": "~6.1.3",
    "typebox": "~1.4.2",
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  }
}
