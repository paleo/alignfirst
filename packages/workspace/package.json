{
  "name": "@paleo/workspace",
  "version": "0.31.0",
  "description": "Run multiple git-worktree dev environments side by side.",
  "keywords": [
    "workspace",
    "worktree",
    "environment",
    "concurrent",
    "isolated",
    "local",
    "dev-server"
  ],
  "license": "CC0-1.0",
  "author": "Thomas MUR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/workspace"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@11.19.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clear": "rimraf dist/*",
    "lint": "biome check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "~24.13.3",
    "rimraf": "~6.1.3",
    "typescript": "~7.0.2",
    "vitest": "~4.1.11"
  }
}
