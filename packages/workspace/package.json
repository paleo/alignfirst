{
  "name": "@alignfirst/workspace",
  "version": "0.42.0",
  "description": "Run multiple git-worktree dev environments side by side.",
  "keywords": [
    "workspace",
    "worktree",
    "environment",
    "concurrent",
    "isolated",
    "local",
    "dev-server"
  ],
  "license": "CC0-1.0",
  "author": "Thomas MUR",
  "homepage": "https://alignfirst.paroi.tech/workspaces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/workspace"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@12.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./git": {
      "types": "./dist/git.d.ts",
      "import": "./dist/git.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clear": "rimraf dist/*",
    "lint": "biome check",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@alignfirst/docmap": "~0.12.0",
    "ajv": "~8.20.0",
    "ajv-formats": "~3.0.1",
    "jsonc-parser": "~3.3.1"
  },
  "devDependencies": {
    "@types/node": "~26.6.5",
    "rimraf": "~6.1.3",
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  }
}
