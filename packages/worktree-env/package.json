{
  "name": "@paleo/worktree-env",
  "version": "0.9.1",
  "description": "Worktree-based concurrent local environment kernel.",
  "keywords": [
    "worktree",
    "environment",
    "concurrent",
    "local"
  ],
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/worktree-env"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@11.11.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clear": "rimraf dist/*",
    "lint": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm i && npm run clear && npm run build && npm run lint && npm run test"
  },
  "devDependencies": {
    "@types/node": "~24.12.3",
    "rimraf": "~6.1.3",
    "typescript": "~6.0.3",
    "vitest": "~4.1.6"
  }
}
