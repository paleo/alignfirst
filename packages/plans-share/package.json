{
  "name": "@paleo/plans-share",
  "version": "0.5.0",
  "license": "CC0-1.0",
  "author": "Thomas MUR",
  "description": "Share AlignFirst plans through a team plans repository.",
  "keywords": [
    "alignfirst",
    "plans",
    "specs",
    "repository",
    "ai",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/plans-share"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@11.12.1",
  "type": "module",
  "bin": {
    "plans-share": "bin/plans-share.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clear": "rimraf dist/*",
    "lint": "biome check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "~24.12.4",
    "rimraf": "~6.1.3",
    "typescript": "~6.0.3",
    "vitest": "~4.1.7"
  }
}
