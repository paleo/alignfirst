{
  "name": "@alignfirst/alproject",
  "version": "0.4.0",
  "license": "CC0-1.0",
  "author": "Thomas MUR",
  "description": "Discover the projects of an AlignFirst Dev Kit host and allocate their port ranges.",
  "keywords": [
    "alignfirst",
    "cli",
    "git",
    "projects",
    "worktrees"
  ],
  "homepage": "https://alignfirst.paroi.tech/openclaw-dev-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/alignfirst.git",
    "directory": "packages/alproject"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "npm@11.19.0",
  "type": "module",
  "bin": {
    "alproject": "bin/alproject.mjs"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clear": "rimraf dist/*",
    "lint": "biome check",
    "test": "vitest run"
  },
  "dependencies": {
    "arktype": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "~24.13.3",
    "rimraf": "~6.1.3",
    "typescript": "~7.0.2",
    "vitest": "~5.0.1"
  }
}
