{
  "gateway": {
    "mode": "local",
    "auth": { "mode": "none" }
  },
  "plugins": {
    "allow": ["codex", "browser", "discord-mock", "slack-mock", "alignfirst-service"],
    "load": {
      "paths": [
        "/opt/openclaw-test/src/node_modules/@alignfirst/openclaw-discord-mock",
        "/opt/openclaw-test/src/node_modules/@alignfirst/openclaw-slack-mock",
        "/opt/openclaw-test/src/node_modules/@alignfirst/service-openclaw-plugin"
      ]
    },
    "entries": {
      "codex": { "enabled": true },
      "discord-mock": { "enabled": true },
      "slack-mock": { "enabled": true },
      "alignfirst-service": {
        "enabled": true,
        "config": {
          "channelSurfaces": {
            "slack-mock": "slack",
            "discord-mock": "discord"
          }
        }
      }
    },
    "slots": { "memory": "none" }
  },
  "memory": {
    "search": { "enabled": false, "rememberAcrossConversations": false }
  },
  "skills": {
    "workshop": { "autonomous": { "mode": "off" } }
  },
  "update": { "checkOnStart": false },
  "tools": {
    "profile": "coding",
    "alsoAllow": ["message", "browser", "thread_handoff"],
    "message": { "crossContext": { "allowAcrossProviders": false } },
    "deny": ["ask_user"],
    "toolSearch": false,
    "codeMode": false
  },
  "models": {
    "providers": {
      "openai": {
        "agentRuntime": { "id": "openclaw" },
        "baseUrl": "https://chatgpt.com/backend-api/codex",
        "api": "openai-chatgpt-responses"
      },
      "custom-anthropic": {
        "agentRuntime": { "id": "openclaw" },
        "baseUrl": "https://api.anthropic.com",
        "apiKey": "${ANTHROPIC_API_KEY}",
        "api": "anthropic-messages",
        "models": [
          {
            "id": "claude-sonnet-5",
            "name": "Claude Sonnet 5",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 3, "output": 15, "cacheRead": 0.3, "cacheWrite": 3.75 },
            "contextWindow": 1000000,
            "maxTokens": 64000
          }
        ]
      },
      "custom-openrouter": {
        "agentRuntime": { "id": "openclaw" },
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKey": "${OPENROUTER_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen/qwen3.8-flash",
            "name": "Qwen 3.8 Flash (OpenRouter)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0.15, "output": 0.47, "cacheRead": 0.016, "cacheWrite": 0.2 },
            "contextWindow": 1000000,
            "maxTokens": 131072
          }
        ]
      },
      "zai": {
        "agentRuntime": { "id": "openclaw" },
        "apiKey": "${ZAI_API_KEY}",
        "baseUrl": "https://api.z.ai/api/paas/v4",
        "api": "openai-completions",
        "models": [
          {
            "id": "glm-5.3",
            "name": "GLM-5.3",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 0.84, "output": 2.64, "cacheRead": 0.156, "cacheWrite": 0 },
            "contextWindow": 1048576,
            "maxTokens": 131072
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "skills": ["alignfirst-setup-guide", "alignfirst-openclaw-playbook"],
      "heartbeat": {
        "every": "24h",
        "target": "last",
        "directPolicy": "allow"
      },
      "compaction": { "memoryFlush": { "enabled": false } },
      "silentReply": { "group": "allow" },
      "blockStreamingDefault": "on",
      "blockStreamingBreak": "text_end",
      "blockStreamingCoalesce": { "minChars": 1, "idleMs": 100 }
    },
    "entries": {
      "main": {
        "name": "OpenClaw Main",
        "model": "openai/gpt-5.6-terra",
        "workspace": "/home/assistant/.openclaw/workspace"
      }
    }
  },
  "channels": {
    "discord-mock": {
      "baseUrl": "http://bus:43123",
      "botUserId": "openclaw",
      "botDisplayName": "myassistant",
      "allowFrom": ["*"]
    },
    "slack-mock": {
      "baseUrl": "http://bus:43123",
      "botUserId": "openclaw",
      "botDisplayName": "myassistant",
      "allowFrom": ["*"],
      "replyToMode": "off",
      "blockStreaming": true
    }
  }
}
