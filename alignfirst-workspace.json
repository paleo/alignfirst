{
  "$schema": "https://cdn.jsdelivr.net/npm/@alignfirst/workspace/schemas/workspace-v1.schema.json",
  "schemaVersion": 1,
  "workspace": {
    "sharedDirs": ["aligndev-openclaw-tests/artifacts"],
    "gitignoredFiles": [
      {
        "path": ".vscode/settings.json",
        "source": { "kind": "mainWorktree" },
        "optional": true
      },
      {
        "path": "aligndev-openclaw-tests/.env.local",
        "source": { "kind": "mainWorktree" },
        "optional": true
      }
    ],
    "finalize": [
      { "name": "npm install", "run": ["npm", "install"] },
      { "name": "npm run build", "run": ["npm", "run", "build"] }
    ],
    "summary": "Workspace ${{ name }} — ${{ status }}\n  Branch: ${{ branch }}\n  Path:   ${{ currentWorktree }}"
  }
}
