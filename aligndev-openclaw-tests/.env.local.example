# Required: the judge runs through OpenRouter. Also serves the example OpenRouter provider.
OPENROUTER_API_KEY=
# Unused: agent tests run Terra only. An empty key drops its example provider from the config.
ANTHROPIC_API_KEY=
ZAI_API_KEY=

# Model ID of each openclaw.json provider. An empty ID drops its provider from the config.
# Terra runs on the OpenAI provider; the other providers are optional examples.
OPENCLAW_TEST_OPENAI_MODEL=<openai-model-id>
OPENCLAW_TEST_ANTHROPIC_MODEL=
# OpenRouter IDs keep their vendor prefix, for example <vendor>/<model-id>.
OPENCLAW_TEST_OPENROUTER_MODEL=
# Z.AI runs on OpenClaw's native `zai` provider, whose adapter handles the model's tool-call
# format and reasoning. openclaw.json points it at the prepaid (general API) endpoint, not
# the Coding Plan one, whose ~2-request concurrency cap kills multi-lane turns.
OPENCLAW_TEST_ZAI_MODEL=

# Agent model catalog. Comma list of full LiteLLM provider/model refs — the only
# place the provider/ prefix appears. `run --model <id>`, `env up` and OPENCLAW_DEFAULT_TEST_MODEL
# use the bare id (the suffix after the last "/"). `--model all` runs every entry and
# needs the API key for each referenced provider.
OPENCLAW_TEST_MODELS=openai/<openai-model-id>
OPENCLAW_DEFAULT_TEST_MODEL=<openai-model-id>

# Required: the judge's LiteLLM provider/model ref, "openrouter/<vendor>/<model-id>" or
# "anthropic/<model-id>".
OPENCLAW_TEST_JUDGE_MODEL=openrouter/<vendor>/<model-id>
# Optional: the judge's reasoning effort (low, medium, high, xhigh or max; OpenRouter also
# accepts none and minimal). Unset, the request sends none (OpenRouter: temperature 0).
# OPENCLAW_TEST_JUDGE_EFFORT=low
# Optional: the judge's prices in USD per million tokens. Unset, the judge cost is unknown.
# OPENCLAW_TEST_JUDGE_INPUT_USD_PER_MTOK=
# OPENCLAW_TEST_JUDGE_OUTPUT_USD_PER_MTOK=

# Required for Terra, which runs on ChatGPT/Codex OAuth. See
# ../docs/aligndev-openclaw/running-openclaw-tests.md for the dedicated login. The gateway mounts
# this directory read-only.
# OPENCLAW_CODEX_HOME=/absolute/path/to/aligndev-openclaw-tests/.codex-home

# Required: host path to the OpenClaw workspace (mounted into the gateway).
OPENCLAW_WORKSPACE_DIR=./workspace

# Required: host path to the monorepo root. Run `npm run build` there first so the
# mounted aligndev, alignfirst, and docmap packages have built output.
ALIGNFIRST_REPO_DIR=..

# Required: mocked child (codex|claude|pi) launched through the generated mock-agent profile.
# This is independent of the OpenClaw conversation model and its Codex credential import.
# No Pi installation or credentials are needed for the mocked child.
CODING_AGENT=codex
# Optional: comma list narrowing the selected agent's `aligndev code` models, or an explicit full
# Codex slug or Pi-native selector. A09 selects terra, sonnet or, with CODING_AGENT=pi, the
# PI_CONTRACT_MODEL selector of scripts/coding-agent-settings.ts.
# CODING_AGENT_MODELS=terra

# Optional: run N matrix cells concurrently, each on its own worker stack
# (`run --parallel` wins over this). A development laptop handles 3.
OPENCLAW_TEST_PARALLEL=3

# Optional overrides (defaults relative to the project dir):
# OPENCLAW_CONFIG_PATH=./openclaw.json
# OPENCLAW_TEST_SCENARIOS_DIR=./scenarios
# OPENCLAW_TEST_ARTIFACTS_DIR=./artifacts
# OPENCLAW_TEST_GATEWAY_LOGS_DIR=./.gateway-logs

# Opt-in: also write raw-stream.jsonl alongside the always-on provider-neutral
# trajectory log (one <sessionId>.jsonl per session under .gateway-logs/trajectory/).
# OPENCLAW_RAW_STREAM=1
