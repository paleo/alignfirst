{
  "schemaVersion": 1,
  "workspace": {
    "finalize": [{ "name": "Install", "run": ["pnpm", "install", "--frozen-lockfile"] }],
    "summary": "Workspace ${{ name }} — ${{ status }}\nBranch: ${{ branch }}\nPath: ${{ currentWorktree }}"
  },
  "devServer": {
    "ports": { "first": 6500, "last": 6519, "declare": ["frontend"] },
    "runFiles": [
      {
        "path": "local.env",
        "source": { "kind": "committed", "path": "local.env.example" },
        "patch": { "command": { "run": ["node", "scripts/workspace/run-file.mjs"] } }
      }
    ],
    "runFilesInputs": ["REMOTE_DEV_DOMAIN", "REMOTE_DEV_HOST"],
    "servers": [
      {
        "kind": "spawn",
        "name": "app",
        "exec": { "run": ["node", "app.mjs"] },
        "port": "frontend",
        "ready": { "log": "listening on" }
      }
    ],
    "summary": { "command": { "run": ["node", "scripts/workspace/summary.mjs"] } }
  }
}
