    "@paleo/alignfirst-developer-openclaw-plugin": "file:vendor/alignfirst-developer-openclaw-plugin.tgz",
    "openclaw": "2026.9.4"
  },
  "devDependencies": {
    "@types/node": "~26.5.0",
    "typescript": "~7.0.2"
