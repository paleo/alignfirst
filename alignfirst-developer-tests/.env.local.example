ANTHROPIC_API_KEY=
# Required only when running a Qwen model (OpenRouter); harmlessly empty otherwise.
OPENROUTER_API_KEY=
# Required only when running GLM (native `zai` provider, prepaid credits); harmlessly empty otherwise.
ZAI_API_KEY=

# Agent model catalog. Comma list of full LiteLLM provider/model refs — the only
# place the provider/ prefix appears. `run --model <id>` and OPENCLAW_DEFAULT_TEST_MODEL
# use the bare id (the suffix after the last "/"). `--model all` runs every entry and
# needs the API key for each referenced provider. GLM 5.2 runs on OpenClaw's native
# `zai` provider, not OpenRouter — that adapter handles GLM's tool-call format and
# reasoning correctly. openclaw.json points it at the prepaid (general API) endpoint,
# not the Coding Plan one, whose ~2-request concurrency cap kills multi-lane turns.
OPENCLAW_TEST_MODELS=custom-anthropic/claude-sonnet-5,custom-openrouter/qwen/qwen3.7-plus,zai/glm-5.2,openai/gpt-5.6-terra
OPENCLAW_DEFAULT_TEST_MODEL=claude-sonnet-5

# Required only when running an OpenAI model with ChatGPT/Codex OAuth. See README.md for the
# dedicated login. The gateway mounts this directory read-only.
# OPENCLAW_CODEX_HOME=/absolute/path/to/alignfirst-developer-tests/.codex-home

# Required: host path to the OpenClaw workspace (mounted into the gateway).
OPENCLAW_WORKSPACE_DIR=./workspace

# Required: host path to the playbook skill, bind-mounted live over the
# gateway's baked copy so playbook edits iterate without a rebuild (relative to this dir).
ALIGNFIRST_DEVELOPER_PLAYBOOK_SKILL_DIR=../skills/alignfirst-developer-openclaw-playbook

# Required: host path to the built @paleo/alcode package (the coding-delegation CLI the
# gateway runs; its --guide is the delegation manual). Build it first:
# `npm run build --workspace @paleo/alcode` from the repo root, so packages/alcode/dist
# exists. Live-mounted read-only at /opt/alcode (guide edits in templates/ iterate live);
# a /usr/local/bin/alcode wrapper on PATH resolves to it.
ALIGNFIRST_CODE_DIR=../packages/alcode

# Required: coding agent launched by alcode inside the gateway. Codex is the recommended primary
# harness path. This does not select the OpenClaw conversation model.
ALIGNFIRST_CODE_AGENT=codex
# Optional: narrow the selected agent's alcode models or use an explicit full Codex slug.
# ALIGNFIRST_CODE_MODELS=terra

# Optional: run N matrix cells concurrently, each on its own worker stack
# (`run --parallel` wins over this).
# OPENCLAW_TEST_PARALLEL=6

# Optional overrides (defaults relative to the project dir):
# OPENCLAW_CONFIG_PATH=./openclaw.json
# OPENCLAW_TEST_SCENARIOS_DIR=./scenarios
# OPENCLAW_TEST_ARTIFACTS_DIR=./artifacts
# OPENCLAW_TEST_GATEWAY_LOGS_DIR=./.gateway-logs

# Opt-in: also write raw-stream.jsonl alongside the always-on provider-neutral
# trajectory log (one <sessionId>.jsonl per session under .gateway-logs/trajectory/).
# OPENCLAW_RAW_STREAM=1
