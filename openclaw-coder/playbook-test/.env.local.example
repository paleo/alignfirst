ANTHROPIC_API_KEY=

# Required: host path to the OpenClaw workspace (mounted into the gateway).
OPENCLAW_WORKSPACE_DIR=../workspace

# Optional: host path to the alignfirst-agent skill, bind-mounted live over the
# gateway's baked copy so playbook edits iterate without a rebuild.
# Default (relative to this dir): ../../skills/alignfirst-agent
# ALIGNFIRST_AGENT_SKILL_DIR=../../skills/alignfirst-agent

# Optional overrides (defaults relative to the project dir):
# OPENCLAW_CONFIG_PATH=./openclaw.json
# OPENCLAW_TEST_SCENARIOS_DIR=./scenarios
# OPENCLAW_TEST_ARTIFACTS_DIR=./artifacts
# OPENCLAW_TEST_GATEWAY_LOGS_DIR=./.gateway-logs

# Opt-in: also write raw-stream.jsonl alongside the always-on anthropic-payload.jsonl
# OPENCLAW_RAW_STREAM=1
